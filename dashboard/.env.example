# Optional: point at a different features directory.
# Default (when unset): ../docs/features (relative to dashboard/)
# DASHBOARD_FEATURES_DIR=/absolute/path/to/features

# Demo mode: read fixtures/demo-features/* instead of the real folder.
# DASHBOARD_DEMO=1

# Chat agent mode (billed at Anthropic API rates): auto | on | off
#   auto (default) - chat shown only when ANTHROPIC_API_KEY is set and valid
#   on             - always show chat (e.g. when using a Claude Code login)
#   off            - hide chat; /api/agent/** returns 404
# Restart the dev server after changing this.
# DASHBOARD_AGENT=auto
